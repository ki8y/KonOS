                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Control Panel\\Desktop",
                            "Value": "MenuShowDelay",
                            "Data": "0",
                            "DataType": 1
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
                            "Value": "EnableToolTips",
                            "Data": 0,
                            "DataType": 4
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
                            "Value": "ListBoxSmoothScrolling",
                            "Data": 0,
                            "DataType": 4
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects",
                            "Value": "MenuAnimations",
                            "Data": 0,
                            "DataType": 4
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Control Panel\\Desktop",
                            "Value": "SmoothScroll",
                            "Data": "0",
                            "DataType": 1
                        }
                    ]
                },

                "SelectionRectangle": {
                    "Name": "Selection Rectangle",
                    "Description": "Toggle selection rectangle",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
                            "Value": "ListviewAlphaSelect",
                            "Data": 0,
                            "DataType": 4
                        }
                    ]
                },

                "FontSmoothing": {
                    "Name": "Font Smoothing",
                    "Description": "Toggle font smoothing",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
                            "Value": "FontSmoothing",
                            "Data": 2,
                            "DataType": 4
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Control Panel\\Desktop",
                            "Value": "FontSmoothing",
                            "Data": "2",
                            "DataType": 1
                        }
                    ]
                },

                "SlideComboBoxes": {
                    "Name": "Slide Combo Boxes",
                    "Description": "Toggles sliding combo boxes",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
                            "Value": "ComboBoxAnimation",
                            "Data": 0,
                            "DataType": 4
                        }
                    ]
                },

                "DesktopShadows": {
                    "Name": "Desktop Shadows",
                    "Description": "Toggles desktop shadows",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
                            "Value": "ListviewShadow",
                            "Data": 0,
                            "DataType": 4
                        }
                    ]
                },

                "MediaThumbnails": {
                    "Name": "Media Thumbnails",
                    "Description": "Toggles photo and video file thumbnails",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
                            "Value": "IconsOnly",
                            "Data": 0,
                            "DataType": 4
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
                            "Value": "ThumbnailCacheSize",
                            "Data": 0,
                            "DataType": 4
                        }
                    ]
                },

                "ThumbnailCaching": {
                    "Name": "Thumbnail Caching",
                    "Description": "Toggles thumbnail caching",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\DWM",
                            "Value": "AlwaysHibernateThumbnails",
                            "Data": 0,
                            "DataType": 4
                        }
                    ]
                },

                "SmoothScrolling": {
                    "Name": "Smooth Scrolling",
                    "Description": "Toggles smooth scrolling",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Control Panel\\Desktop",
                            "Value": "SmoothScroll",
                            "Data": 0,
                            "DataType": 4
                        }
                    ]
                }
            }
        },
        "Shell": {
            "Name": "Shell tweaks",
            "Tweaks": {
                "EndTaskButton": {
                    "Name": "End Task in Taskbar",
                    "Description": "Toggles the \"End Task\" button in the taskbar.",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced\\TaskbarDeveloperSettings",
                            "Value": "TaskbarEndTask",
                            "Data": 1,
                            "DataType": 4
                        }
                    ]
                },

                "ShowHiddenFilesAndExtensions": {
                    "Name": "Show hidden files and file extensions",
                    "Description": "When enabled, you will be able to see hidden files and all file extensions.",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
                            "Value": "HideFileExt",
                            "Data": 0,
                            "DataType": 4
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
                            "Value": "UseCompactMode",
                            "Data": 1,
                            "DataType": 4
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced\\Folder\\Hidden\\SHOWALL",
                            "Value": "CheckedValue",
                            "Data": 1,
                            "DataType": 4
                        }
                    ]
                },

                "DarkMode": {
                    "Name": "Dark mode",
                    "Description": "Toggles dark mode.",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
                            "Value": "SystemUsesLightTheme",
                            "Data": 0,
                            "DataType": 4
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
                            "Value": "AppsUseLightTheme",
                            "Data": 0,
                            "DataType": 4
                        }
                    ]
                },

                "DisableTransparency": {
                    "Name": "Disable Transparency",
                    "Description": "When enabled, all transparency in Windows will be disabled.",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
                            "Value": "EnableTransparency",
                            "Data": 0,
                            "DataType": 4
                        }
                    ]
                },

                "LogonBlur": {
                    "Name": "Disable Logon Blur",
                    "Description": "When enabled, the blur on the logon screen will be disabled.",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Windows\\System",
                            "Value": "DisableAcrylicBackgroundOnLogon",
                            "Data": 1,
                            "DataType": 4
                        }
                    ]
                },

                "LiveTiles": {
                    "Name": "Disable Live Tiles",
                    "Description": "When enabled, Live Tiles will be disabled on Windows 10.",
                    "MaxBuild": "19045",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\SOFTWARE\\Policies\\Microsoft\\Windows\\CurrentVersion\\PushNotifications",
                            "Value": "NoTileApplicationNotification",
                            "Data": 1,
                            "DataType": 4
                        }
                    ]
                }
            }
        },
        "Misc": {
            "Name": "Miscellaneous Tweaks",
            "Tweaks": {
                "MouseAcceleration": {
                    "Name": "Mouse Acceleration",
                    "Description": "Toggles mouse acceleration",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Control Panel\\Mouse",
                            "Value": "MouseSpeed",
                            "Data": "0",
                            "DataType": 1
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Control Panel\\Mouse",
                            "Value": "MouseThreshold1",
                            "Data": "0",
                            "DataType": 1
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Control Panel\\Mouse",
                            "Value": "MouseThreshold2",
                            "Data": "0",
                            "DataType": 1
                        }
                    ]
                },

                "ShutdownTweaks": {
                    "Name": "Shutdown Tweaks",
                    "Description": "When enabled, Windows will no longer prompt you to save your work before shutting down.",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Control Panel\\Desktop",
                            "Value": "AutoEndTasks",
                            "Data": "1",
                            "DataType": 1
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Control Panel\\Desktop",
                            "Value": "HungAppTimeout",
                            "Data": "1000",
                            "DataType": 1
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Control Panel\\Desktop",
                            "Value": "WaitToKillAppTimeout",
                            "Data": "1000",
                            "DataType": 1
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Control Panel\\Desktop",
                            "Value": "LowLevelHooksTimeout",
                            "Data": "1000",
                            "DataType": 1
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control",
                            "Value": "WaitToKillServiceTimeout",
                            "Data": "1000",
                            "DataType": 1
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power",
                            "Value": "HiberbootEnabled",
                            "Data": 0,
                            "DataType": 4
                        }
                    ]
                },

                "StickyKeys": {
                    "Name": "Sticky keys",
                    "Description": "Toggle sticky keys shortcut",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Control Panel\\Accessibility\\StickyKeys",
                            "Value": "Flags",
                            "Data": "506",
                            "DataType": 1
                        }
                    ]
                },

                "CoreIsolation": {
                    "Name": "Core Isolation Tweaks",
                    "Description": "When enabled, core isolation will be disabled.",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_LOCAL_MACHINE\\System\\CurrentControlSet\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforcedCodeIntegrity",
                            "Value": "Enabled",
                            "Data": 0,
                            "DataType": 4
                        }
                    ]
                }
            }
        },

        "Privacy": {
            "Name": "Privacy Tweaks",
            "Tweaks": {
                "DisableTelemetry": {
                    "Name": "Disable Telemetry",
                    "Description": "When enabled, Kon OS will attempt to disable as much telemetry as it can.",
                    "DefaultAction": "Enabled",
                    "Apply": [
                        {
                            "Type": "ScheduledTask",
                            "State": "Disabled",
                            "TaskPath": "Microsoft\\Windows\\Windows Error Reporting",
                            "TaskName": "QueueReporting"
                        }
                    ],
                    "Undo": [
                        {
                            "Type": "ScheduledTask",
                            "State": "Disabled",
                            "TaskPath": "Microsoft\\Windows\\Windows Error Reporting",
                            "TaskName": "QueueReporting"
                        }
                    ]
                }
            }
        }
    }
}
