{
    "GeneralTweaks": {
        "Search": {
            "Name": "Search Tweaks",
            "Tweaks": {
                "DisableAccountSync": {
                    "Name": "Disable Cloud Search",
                    "Description": "When enabled, Microsoft account integration will be disabled in search.",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\SearchSettings",
                            "Value": "IsAADCloudSearchEnabled",
                            "Data": 0,
                            "DataType": 4
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\SearchSettings",
                            "Value": "IsMSACloudSearchEnabled",
                            "Data": 0,
                            "DataType": 4
                        }
                    ]
                },

                "DisableBingSearch": {
                    "Name": "Disable Bing in Search",
                    "Description": "When enabled, Windows Search will no longer use bing.",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Search",
                            "Value": "BingSearchEnabled",
                            "Data": 0,
                            "DataType": 4
                        }
                    ]
                },

                "DisableSearchSuggestions": {
                    "Name": "Disable Search Suggestions",
                    "Description": "When enabled, Search Suggestions will be disabled.",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Policies\\Microsoft\\Windows\\Explorer",
                            "Value": "DisableSearchBoxSuggestions",
                            "Data": 1,
                            "DataType": 4
                        }
                    ]
                },

                "DisableCopilot": {
                    "Name": "Disable Copilot",
                    "Description": "When enabled, Copilot will be disbaled.",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Policies\\Microsoft\\Windows\\WindowsCopilot",
                            "Value": "TurnOffWindowsCopilot",
                            "Data": 1,
                            "DataType": 4
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
                            "Value": "ShowCopilotButton",
                            "Data": 0,
                            "DataType": 4
                        }
                    ],
                    "Undo": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Policies\\Microsoft\\Windows\\WindowsCopilot",
                            "Value": "TurnOffWindowsCopilot",
                            "Data": 0,
                            "DataType": 4
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
                            "Value": "ShowCopilotButton",
                            "Data": 1,
                            "DataType": 4
                        }
                    ]
                },

                "DisableBackgroundUsage": {
                    "Name": "Disable search background usage",
                    "Description": "Stops search from running in the background.",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Search",
                            "Value": "BackgroundAppGlobalToggle",
                            "Data": 0,
                            "DataType": 4
                        }
                    ],
                    "Undo": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Search",
                            "Value": "BackgroundAppGlobalToggle",
                            "Data": 1,
                            "DataType": 4
                        }
                    ]
                }
            }
        },

        "StartMenu": {
            "Name": "Start Menu Tweaks",
            "Tweaks": {
                "RecommendedSection": {
                    "Name": "Recommended Section",
                    "Description": "Disables Recommended Section in Start Menu",
                    "MinBuild": 22000,
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Policies\\Microsoft\\Windows\\Explorer",
                            "Value": "HideRecommendedSection",
                            "Data": 1,
                            "DataType": 4
                        }
                    ]
                }
            }
        },

        "AdjustVisualSettings": {
            "Name": "Adjust Visual Settings",
            "Tweaks": {
                "TaskbarAnimations": {
                    "Name": "Taskbar Animations",
                    "Description": "Toggles Taskbar Animations",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects",
                            "Value": "TaskbarAnimations",
                            "Data": 0,
                            "DataType": 4
                        },
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
                            "Value": "TaskbarAnimations",
                            "Data": 0,
                            "DataType": 4
                        }
                    ]
                },

                "AeroPeek": {
                    "Name": "Aero Peek",
                    "Description": "Toggle Aero Peek",
                    "Apply": [
                        {
                            "Type": "Registry",
                            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\DWM",
                            "Value": "EnableAeroPeek",
                            "Data": 0,
                            "DataType": 4
                        }
                    ]
                },

                "MenuAnimations": {
                    "Name": "Menu Animations",
