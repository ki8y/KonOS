{
  "GeneralTweaks": {
    "Search": {
      
      "DisableAccountSync": {
        "Name": "Disable Cloud Search",
        "Description": "Disables Microsoft account integration in search.",
        "Registry": [
          {
            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\SearchSettings",
            "Value": "IsAADCloudSearchEnabled",
            "Data": 0,
            "Type": 4
          },
          {
            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\SearchSettings",
            "Value": "IsMSACloudSearchEnabled",
            "Data": 0,
            "Type": 4
          }
        ]
      },
      
      "DisableBingSearch": {
        "Name": "Disable Bing in Search",
        "Description": "Disables Bing results in the Windows search menu.",
        "Registry": [
          {
          "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Search",
          "Value": "BingSearchEnabled",
          "Data": 0,
          "Type": 4
          }
        ]
      },
      
      "DisableSearchSuggestions": {
        "Name": "Disable Search Suggestions",
        "Description": "Disables automatic suggestions in search.",
        "Registry": [
          {
            "Key": "HKEY_CURRENT_USER\\Software\\Policies\\Microsoft\\Windows\\Explorer",
            "Value": "DisableSearchBoxSuggestions",
            "Data": 1,
            "Type": 4
          }
        ]
      },
      
      "DisableCopilot": {
        "Name": "Disable Copilot",
        "Description": "Disables Copilot Across Windows",
        "Registry": [
          {
            "Key": "HKEY_CURRENT_USER\\Software\\Policies\\Microsoft\\Windows\\WindowsCopilot",
            "Value": "TurnOffWindowsCopilot",
            "Data": 1,
            "Type": 4
          },
          {
            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
            "Value": "ShowCopilotButton",
            "Data": 0,
            "Type": 4
          }
        ]
      },

      "DisableBackgroundUsage": {
        "Name": "Disable search background usage",
        "Description": "Stops search from running in the background.",
          "Registry": [
          {
            "Key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Search",
            "Value": "BackgroundAppGlobalToggle",
            "Data": 0,
            "Type": 4
          }
        ]
      }
    
    },

    "StartMenu": {
      
      "HideRecommendedSection": {
        "Name": "Disable Recommended Section",
        "Description": "Disables Recommended Section in Start Menu",
          "Registry": [
          {
            "Key": "HKEY_CURRENT_USER\\Software\\Policies\\Microsoft\\Windows\\Explorer",
            "Value": "HideRecommendedSection",
            "Data": 1,
            "Type": 4
          }
        ]
      }
    
    }
  }

}
